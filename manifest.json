{
  "manifest_version": 3,
  "name": "Auto Next Lecture",
  "version": "0.1.0",
  "description": "영상이 끝나면 '다음 강의' 버튼을 자동으로 눌러줍니다.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Auto Next Lecture",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://coloso.co.kr/*",
        "https://*.coloso.co.kr/*",
        "https://*.kollus.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://coloso.co.kr/*", "https://*.coloso.co.kr/*"],
      "js": ["main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
